# Copia este archivo como .env y completa tus datos.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

# Token personal de developer.webex.com (dura 12 horas)
WEBEX_TOKEN=pega_aqui_tu_token

# Título de tu sala: nombre_apellido, en minúsculas y sin tildes
MI_NOMBRE=maria_gonzalez

# Tu nombre y apellido tal como aparecerá en el mensaje
NOMBRE_COMPLETO=María González

# Correo con el que tu compañero(a) inició sesión en Webex
EMAIL_COMPANERO=companero@ejemplo.com
