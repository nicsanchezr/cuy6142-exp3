# Copia este archivo como .env y completa tus datos.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

# Token del bot (se muestra una sola vez al crearlo en developer.webex.com)
WEBEX_BOT_TOKEN=pega_aqui_el_token_del_bot

# Correos que pueden usar el bot, separados por coma. El PRIMERO debe ser el tuyo
# (con esa persona conversa 00_bot_manual.py)
USUARIOS_PERMITIDOS=tu_correo@ejemplo.com,companero@ejemplo.com

# API key de OpenRouter (https://openrouter.ai/keys) para la Parte 6
OPENROUTER_API_KEY=pega_aqui_tu_api_key

# Modelo de IA: openrouter/free elige automáticamente un modelo gratuito
OPENROUTER_MODELO=openrouter/free
